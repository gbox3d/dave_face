# 비밀·상태·생체 데이터(DB, 토큰, 사진, 로그)는 git 밖에 둔다
localfiles/

# 모델 파일은 scripts/fetch-onnx.sh(ONNX zip) + scripts/build-engines.sh(TensorRT 엔진, 이 보드 전용)로 만든다 — SHA256SUMS 만 추적.
# models/5.4.0 의 HEF 규칙은 Pi(main 브랜치) 용으로 남겨 둔다.
models/**/*.hef
models/**/*.hef.tmp
models/**/*.onnx
models/onnx/*.zip
models/onnx/*.zip.tmp
models/trt/

# MediaPipe Face Mesh: WASM(node_modules 복사)·모델은 scripts/fetch-mediapipe.sh 가 만든다
apps/web/public/assets/mediapipe/

# Node
node_modules/
dist/

# Python (uv)
.venv/
__pycache__/
*.py[oc]
*.egg-info/

# HailoRT 가 작업 디렉터리에 남기는 로그
hailort.log
pyhailort.log
